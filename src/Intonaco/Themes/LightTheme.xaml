<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBackgroundColor">#FFF4F5F7</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="CardBorderColor">#FFE1E4EA</Color>
    <Color x:Key="TextPrimaryColor">#FF191B20</Color>
    <Color x:Key="TextSecondaryColor">#FF616674</Color>
    <Color x:Key="AccentColor">#FF0078D4</Color>
    <Color x:Key="AccentHoverColor">#FF2B8FE0</Color>
    <Color x:Key="AccentPressedColor">#FF006CBE</Color>
    <Color x:Key="ButtonBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="ButtonHoverColor">#FFF0F1F5</Color>
    <Color x:Key="ButtonPressedColor">#FFE5E7EE</Color>
    <Color x:Key="ButtonBorderColor">#FFD4D7E0</Color>
    <Color x:Key="DividerColor">#FFE1E4EA</Color>
    <Color x:Key="InputBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="InputHoverColor">#FFF5F6F8</Color>
    <Color x:Key="InputBorderColor">#FFC9CEDA</Color>
    <Color x:Key="SubtleBackgroundColor">#FFEEF0F4</Color>
    <Color x:Key="PreviewBackgroundColor">#FFDDE3EE</Color>
    <Color x:Key="TrackBackgroundColor">#FFD6DAE3</Color>
    <Color x:Key="ErrorColor">#FFD13438</Color>
    <Color x:Key="SuccessColor">#FF168F4B</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="{StaticResource ButtonPressedColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource ButtonBorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="InputHoverBrush" Color="{StaticResource InputHoverColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="{StaticResource SubtleBackgroundColor}" />
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="{StaticResource PreviewBackgroundColor}" />
    <SolidColorBrush x:Key="TrackBackgroundBrush" Color="{StaticResource TrackBackgroundColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F0078D4" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F168F4B" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#1FD13438" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2B9BEB" Offset="0" />
        <GradientStop Color="#FF0078D4" Offset="0.55" />
        <GradientStop Color="#FF5B5BD6" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
