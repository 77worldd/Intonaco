<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 / WinUI-style neutral palette - Light theme. -->
    <Color x:Key="WindowBackgroundColor">#FFF3F3F3</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="CardBorderColor">#FFE6E6E6</Color>
    <Color x:Key="TextPrimaryColor">#FF1C1C1C</Color>
    <Color x:Key="TextSecondaryColor">#FF616161</Color>
    <Color x:Key="AccentColor">#FF065A8C</Color>
    <Color x:Key="AccentHoverColor">#FF0A6FA8</Color>
    <Color x:Key="AccentPressedColor">#FF044E78</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="ButtonBackgroundColor">#FFFBFBFB</Color>
    <Color x:Key="ButtonHoverColor">#FFF5F5F5</Color>
    <Color x:Key="ButtonPressedColor">#FFEDEDED</Color>
    <Color x:Key="ButtonBorderColor">#FFE1E1E1</Color>
    <Color x:Key="DividerColor">#FFE6E6E6</Color>
    <Color x:Key="InputBackgroundColor">#FFFBFBFB</Color>
    <Color x:Key="InputHoverColor">#FFF5F5F5</Color>
    <Color x:Key="InputBorderColor">#FFD6D6D6</Color>
    <Color x:Key="SubtleBackgroundColor">#FFF0F0F0</Color>
    <Color x:Key="PreviewBackgroundColor">#FFE8ECEF</Color>
    <Color x:Key="TrackBackgroundColor">#FFC8C8C8</Color>
    <Color x:Key="ErrorColor">#FFC42B1C</Color>
    <Color x:Key="SuccessColor">#FF0F7B0F</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="{StaticResource ButtonPressedColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource ButtonBorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="InputHoverBrush" Color="{StaticResource InputHoverColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="{StaticResource SubtleBackgroundColor}" />
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="{StaticResource PreviewBackgroundColor}" />
    <SolidColorBrush x:Key="TrackBackgroundBrush" Color="{StaticResource TrackBackgroundColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#14065A8C" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#140F7B0F" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#14C42B1C" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="AccentGradientBrush" Color="{StaticResource AccentColor}" />

</ResourceDictionary>
