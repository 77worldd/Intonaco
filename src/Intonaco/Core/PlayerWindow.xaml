<Window x:Class="Intonaco.Core.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intonaco Player"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="False"
        Background="Black"
        ResizeMode="NoResize"
        Padding="0" Margin="0"
        Width="800" Height="600"
        Topmost="False">
    <!-- Strict cover mode: no black bars regardless of play/pause.
         The Grid fills 100vw/100vh of the parent WorkerW/Progman,
         background stays black, and media is always UniformToFill. -->
    <Grid x:Name="ContentGrid"
          Background="Black"
          Margin="0"
          ClipToBounds="True"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch" />
</Window>
