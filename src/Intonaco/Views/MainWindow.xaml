<Window x:Class="Intonaco.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Intonaco"
        Icon="/Assets/intonaco.ico"
        Width="520" Height="600"
        MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource DefaultFont}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo Description="Intonaco — Live Wallpaper" />
    </Window.TaskbarItemInfo>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />     <!-- Header -->
            <RowDefinition Height="Auto" />     <!-- Preview area -->
            <RowDefinition Height="Auto" />     <!-- File info -->
            <RowDefinition Height="Auto" />     <!-- Playback controls -->
            <RowDefinition Height="Auto" />     <!-- Settings -->
            <RowDefinition Height="*" />        <!-- Spacer -->
            <RowDefinition Height="Auto" />     <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Intonaco"
                       FontSize="{StaticResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Live wallpaper for Windows"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- Preview -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}"
                Padding="0"
                Height="200"
                Margin="0,0,0,12"
                ClipToBounds="True">
            <Grid>
                <Border Background="#FF1A1A1A" CornerRadius="{StaticResource CardCornerRadius}" />

                <!-- Preview placeholder -->
                <StackPanel x:Name="PreviewPlaceholder"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="&#xE714;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="32"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="No wallpaper selected"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>

                <!-- Preview thumbnail -->
                <MediaElement x:Name="PreviewMedia"
                              Stretch="UniformToFill"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Close"
                              IsMuted="True"
                              Visibility="Collapsed"
                              IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- File info & Choose button -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="FileNameText"
                           Text="No file selected"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="300"
                           HorizontalAlignment="Left" />
                <TextBlock x:Name="FileInfoText"
                           Text=""
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    x:Name="ChooseFileButton"
                    Content="Choose file"
                    Style="{StaticResource AccentButton}"
                    Click="OnChooseFile"
                    Padding="20,8" />
        </Grid>

        <!-- Playback controls -->
        <Border Grid.Row="3"
                Style="{StaticResource CardBorder}"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Play/Pause -->
                <Button x:Name="PlayPauseButton"
                        Grid.Column="0"
                        Style="{StaticResource IconButton}"
                        Content="&#xE768;"
                        ToolTip="Play"
                        Click="OnPlayPause"
                        IsEnabled="False"
                        FontSize="20" />

                <!-- Stop -->
                <Button x:Name="StopButton"
                        Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Content="&#xE71A;"
                        ToolTip="Stop wallpaper"
                        Click="OnStop"
                        IsEnabled="False"
                        Margin="4,0" />

                <!-- Mute toggle -->
                <Button x:Name="MuteButton"
                        Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Content="&#xE74F;"
                        ToolTip="Unmute"
                        Click="OnToggleMute" />

                <!-- Volume slider -->
                <Slider x:Name="VolumeSlider"
                        Grid.Column="3"
                        Style="{StaticResource IntonacoSlider}"
                        Minimum="0" Maximum="100"
                        Value="0"
                        VerticalAlignment="Center"
                        Margin="8,0"
                        ValueChanged="OnVolumeChanged" />

                <!-- Status indicator -->
                <TextBlock x:Name="StatusText"
                           Grid.Column="5"
                           Text="Stopped"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- Settings section -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Settings"
                           FontSize="{StaticResource FontSizeSubtitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,12" />

                <!-- Pause on fullscreen -->
                <CheckBox x:Name="PauseFullscreenToggle"
                          Style="{StaticResource IntonacoToggle}"
                          Content="Pause when fullscreen app is active"
                          Margin="0,0,0,10"
                          Checked="OnSettingChanged"
                          Unchecked="OnSettingChanged" />

                <!-- Start with Windows -->
                <CheckBox x:Name="StartWithWindowsToggle"
                          Style="{StaticResource IntonacoToggle}"
                          Content="Start with Windows"
                          Margin="0,0,0,10"
                          Checked="OnStartupChanged"
                          Unchecked="OnStartupChanged" />

                <!-- FPS Limit -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Frame rate limit"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox x:Name="FpsComboBox"
                                  Width="80"
                                  SelectionChanged="OnFpsChanged"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="15 fps" Tag="15" />
                            <ComboBoxItem Content="24 fps" Tag="24" />
                            <ComboBoxItem Content="30 fps" Tag="30" IsSelected="True" />
                            <ComboBoxItem Content="60 fps" Tag="60" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Theme -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Theme"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <ComboBox x:Name="ThemeComboBox"
                              Grid.Column="1"
                              Width="100"
                              SelectionChanged="OnThemeChanged"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="System" Tag="System" IsSelected="True" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="6" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ErrorText"
                       Text=""
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource ErrorBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Column="1"
                       Text="v1.0.0"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- System tray icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/Assets/intonaco.ico"
                        ToolTipText="Intonaco"
                        DoubleClickCommand="{x:Null}"
                        Visibility="Visible">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="TrayShowItem" Header="Show Intonaco" Click="OnTrayShow" FontWeight="Bold" />
                    <Separator />
                    <MenuItem x:Name="TrayPlayPauseItem" Header="Play" Click="OnTrayPlayPause" />
                    <MenuItem x:Name="TrayMuteItem" Header="Mute" Click="OnTrayToggleMute" />
                    <Separator />
                    <MenuItem Header="Exit" Click="OnTrayExit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
